{
    "postman.settings.dotenv-detection-notification-visibility": false,

    // ── Clangd: suppress false-positive errors in Flutter-generated C++ files ──
    "clangd.arguments": [
        "--background-index",
        "--header-insertion=never"
    ],
    "C_Cpp.errorSquiggles": "disabled",
    "clangd.enableCodeCompletion": true,

    // Exclude generated Flutter Windows files from file watcher / analysis
